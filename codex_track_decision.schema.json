{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rating",
    "role",
    "moods",
    "component_tags",
    "color",
    "priority",
    "confidence",
    "genre_normalized",
    "genre_tags",
    "similar_tracks",
    "reasoning"
  ],
  "properties": {
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "role": {
      "type": "string",
      "enum": ["OPEN", "WARM", "JOURNEY", "MAIN", "PEAK", "CLOSE"]
    },
    "moods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "enum": ["Deep", "Emotional", "Atmospheric", "Hypnotic", "Driving", "Dark", "Euphoric", "Vocal"]
      }
    },
    "component_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "Vocal",
          "Piano",
          "Dark",
          "Atmospheric",
          "Driving",
          "Peak",
          "Instrumental",
          "Female Vocal",
          "Afro",
          "Organic",
          "Deep",
          "Journey",
          "Breaks",
          "Emotional",
          "Acid",
          "Hypnotic",
          "Psychedelic"
        ]
      }
    },
    "color": {
      "type": "string",
      "enum": ["Purple", "Blue", "Green", "Aqua", "Orange", "Red", "Yellow", "Pink"]
    },
    "priority": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "genre_normalized": {
      "type": "string"
    },
    "genre_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "similar_tracks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasoning": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
